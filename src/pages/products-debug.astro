---
import { getOptimizelySdk } from '../graphql/getSdk';
import { localeToSdkLocale } from '../lib/locale-helpers';

const lang = Astro.currentLocale || 'en';
const loc = localeToSdkLocale(lang);
const site = Astro.url.origin;
const cp = { ctx: 'view', key: '', ver: '', loc, preview_token: '', types: [] };

let sdkErr: any = null;
let total: any = null;
let itemsLen: any = null;
let firstItem: any = null;
let firstItemKeys: any = null;
try {
  const r: any = await getOptimizelySdk(cp as any).getProducts({ loc: loc as any, limit: 400, site } as any);
  total = r?.ProductPage?.total ?? null;
  const items = r?.ProductPage?.items ?? [];
  itemsLen = items.length;
  firstItem = items[0] ?? null;
  firstItemKeys = firstItem ? Object.keys(firstItem) : null;
} catch (e: any) {
  sdkErr = String(e?.message || e);
}
const payload = { loc, site, sdkErr, total, itemsLen, firstItemKeys, firstItem };
---
<html><body><h1>products-debug v3 (SDK call)</h1><pre>{JSON.stringify(payload, null, 2)}</pre></body></html>
