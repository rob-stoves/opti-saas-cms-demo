---
import { getSdk } from '../../__generated/sdk';
import { print } from 'graphql';
import { OPTIMIZELY_GRAPH_GATEWAY, OPTIMIZELY_GRAPH_SINGLE_KEY } from 'astro:env/client';
import { localeToSdkLocale } from '../lib/locale-helpers';

const lang = Astro.currentLocale || 'en';
const loc = localeToSdkLocale(lang);
const site = Astro.url.origin;

let cap: any = {};
const requester = async (doc: any, vars: any) => {
  const q = print(doc);
  const res = await fetch(`${OPTIMIZELY_GRAPH_GATEWAY}/content/v2?auth=${OPTIMIZELY_GRAPH_SINGLE_KEY}`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query: q, variables: vars }),
  });
  const json: any = await res.json();
  cap = {
    query: q,
    variables: vars,
    errors: json.errors ?? null,
    dataKeys: json.data ? Object.keys(json.data) : null,
    total: json?.data?.ProductPage?.total ?? null,
    itemsLen: json?.data?.ProductPage?.items?.length ?? null,
  };
  return json.data;
};

const sdk: any = getSdk(requester as any);
let sdkErr: any = null;
try { await sdk.getProducts({ loc, limit: 400, site } as any); } catch (e: any) { sdkErr = String(e?.message || e); }
const payload = { loc, site, sdkErr, cap };
---
<html><body><h1>debug v5 (generated query)</h1><pre>{JSON.stringify(payload, null, 2)}</pre></body></html>
